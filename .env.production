# PRODUCTION ENVIRONMENT — PARK POS
# DO NOT put real credentials here. Use Vercel Environment Variables.
# See: https://vercel.com/docs/environment-variables

# Database Configuration - Set in Vercel Dashboard
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true&connection_limit=20"
DIRECT_URL="postgresql://user:password@host:5432/database?connection_limit=1"

# Redis Configuration - Set in Vercel Dashboard
REDIS_URL="redis://localhost:6379"

# Security Secrets - Generate with: openssl rand -base64 32
JWT_SECRET="set-in-vercel-dashboard"
REFRESH_TOKEN_SECRET="set-in-vercel-dashboard"
PIN_SALT="set-in-vercel-dashboard"
PARK_API_SECRET="set-in-vercel-dashboard"
ADMIN_API_KEY="set-in-vercel-dashboard"

# VAPID - Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="set-in-vercel-dashboard"
VAPID_PRIVATE_KEY="set-in-vercel-dashboard"
VAPID_SUBJECT="mailto:admin@parkpos.pe"

# Tenant Configuration
TENANT_ID="set-in-vercel-dashboard"
LOCATION_ID="set-in-vercel-dashboard"

# NextAuth Configuration
NEXTAUTH_SECRET="set-in-vercel-dashboard"
NEXTAUTH_URL="https://your-domain.vercel.app"
NEXTAUTH_URL_INTERNAL="https://your-domain.vercel.app"

# CORS Configuration
ALLOWED_ORIGINS="https://your-domain.vercel.app"
