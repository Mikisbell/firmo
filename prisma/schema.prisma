// PARK POS — Prisma Schema
// Version: 1.0 (Enterprise Complete)
// Generated: December 2025

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// CORE: Configuration & Identity
// ============================================================================

model TenantSettings {
  tenant_id                     String   @id @db.Uuid
  legal_name                    String
  ruc                           String?
  address_text                  String?
  logo_url                      String?
  timezone                      String   @default("America/Lima")
  currency                      String   @default("PEN")
  receipt_footer_text           String?
  kds_audio_enabled             Boolean  @default(true)
  kds_audio_volume              Int      @default(80)
  default_delivery_fee_cents    Int      @default(0)
  require_payment_verification  Boolean  @default(false)
  allow_cod                     Boolean  @default(true)
  default_payment_expectation   String   @default("PREPAID")
  enable_tips                   Boolean  @default(true)
  tips_on_invoice               Boolean  @default(false)
  allow_offline_coupon          Boolean  @default(false)
  max_offline_coupons_per_order Int      @default(1)
  require_manager_for_offline   Boolean  @default(true)
  updated_at                    DateTime @default(now()) @db.Timestamptz

  @@map("tenant_settings")
}

model Employee {
  id         String   @id @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  role       String // ADMIN|MANAGER|CASHIER|WAITER|KITCHEN|DRIVER
  pin_hash   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz

  // Relations
  shifts_opened Shift[] @relation("ShiftOpenedBy")
  shifts_closed Shift[] @relation("ShiftClosedBy")

  @@index([tenant_id, is_active])
  @@map("employees")
}

model Terminal {
  id                 String    @id @default(uuid()) @db.Uuid
  tenant_id          String    @db.Uuid
  terminal_id        String
  station_id         String?   @db.Uuid
  device_secret_hash String?
  is_allowed         Boolean   @default(true)
  last_seen_at       DateTime? @db.Timestamptz

  // Relations
  station Station? @relation(fields: [station_id], references: [id])

  @@unique([tenant_id, terminal_id])
  @@map("terminals")
}

model Station {
  id        String  @id @default(uuid()) @db.Uuid
  tenant_id String  @db.Uuid
  code      String
  name      String
  is_active Boolean @default(true)

  // Relations
  terminals Terminal[]
  printers  Printer[]

  @@unique([tenant_id, code])
  @@map("stations")
}

// ============================================================================
// CORE: Catalog
// ============================================================================

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  sku         String
  name        String
  short_name  String?
  price_cents Int
  category    String
  station     String
  type        String   @default("SIMPLE") // SIMPLE|COMBO
  components  Json? // If combo
  recipe      Json? // For inventory deduction
  is_active   Boolean  @default(true)
  version     Int      @default(1)
  updated_at  DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, sku])
  @@index([tenant_id, category])
  @@map("products")
}

model CatalogMeta {
  tenant_id       String   @id @db.Uuid
  catalog_version Int      @default(1)
  updated_at      DateTime @default(now()) @db.Timestamptz

  @@map("catalog_meta")
}

// ============================================================================
// CORE: Orders (Hot Path)
// ============================================================================

model Order {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  order_number        Int
  order_type          String // DINE_IN|TAKEOUT|DELIVERY
  order_status        String   @default("OPEN") // OPEN|IN_PROGRESS|DONE|CANCELLED
  fulfillment_status  String   @default("COOKING") // COOKING|PARTIAL_READY|ALL_READY
  handoff_status      String   @default("WAITING") // WAITING|PACKING|READY_FOR_PICKUP|OUT_FOR_DELIVERY|DELIVERED
  stations_active     String[] @default([])
  unpaid_checks_count Int      @default(0)
  subtotal_cents      Int      @default(0)
  discount_cents      Int      @default(0)
  total_cents         Int      @default(0)
  promotion_id        String?  @db.Uuid
  promotion_snapshot  Json?
  coupon_code         String?
  revision            Int      @default(0)
  terminal_id         String
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz

  // JSONB denormalized
  items       Json  @default("[]")
  checks      Json  @default("[]")
  fulfillment Json?
  delivery    Json?

  // Relations
  promotion Promotion? @relation(fields: [promotion_id], references: [id])
  invoices  Invoice[]

  @@index([tenant_id, order_status])
  @@index([tenant_id, created_at(sort: Desc)])
  @@map("orders")
}

// ============================================================================
// CORE: Shifts
// ============================================================================

model Shift {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  terminal_id         String
  status              String    @default("OPEN") // OPEN|CLOSED
  opened_at           DateTime  @default(now()) @db.Timestamptz
  closed_at           DateTime? @db.Timestamptz
  opened_by           String    @db.Uuid
  closed_by           String?   @db.Uuid
  cash_opening_cents  Int
  cash_expected_cents Int?
  cash_counted_cents  Int?
  diff_cents          Int?

  // Relations
  opener Employee  @relation("ShiftOpenedBy", fields: [opened_by], references: [id])
  closer Employee? @relation("ShiftClosedBy", fields: [closed_by], references: [id])

  @@index([tenant_id, status])
  @@map("shifts")
}

// ============================================================================
// CORE: Customers & Delivery
// ============================================================================

model Customer {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  phone            String
  name             String?
  email            String?
  addresses        Json     @default("[]") // Legacy - use DeliveryAddress
  birth_month      Int?
  birth_day        Int?
  marketing_opt_in Boolean  @default(true)
  total_orders     Int      @default(0)
  total_spent      Int      @default(0) // centavos
  last_order_at    DateTime? @db.Timestamptz
  notes            String?
  updated_at       DateTime @default(now()) @db.Timestamptz

  // Relations
  profile           CustomerProfile?
  coupons           Coupon[]
  delivery_addresses DeliveryAddress[]

  @@unique([tenant_id, phone])
  @@map("customers")
}

model Driver {
  id        String  @id @default(uuid()) @db.Uuid
  tenant_id String  @db.Uuid
  name      String
  phone     String?
  is_active Boolean @default(true)

  @@index([tenant_id, is_active])
  @@map("drivers")
}

// ============================================================================
// CORE: Invoices
// ============================================================================

model Invoice {
  id                String    @id @default(uuid()) @db.Uuid
  tenant_id         String    @db.Uuid
  order_id          String    @db.Uuid
  check_id          String
  invoice_type      String // BOLETA|FACTURA
  series            String?
  invoice_number    String?
  customer_doc_type String?
  customer_doc      String?
  total_cents       Int
  payment_summary   Json?
  status            String    @default("ISSUED") // ISSUED|VOIDED|REFUNDED
  void_reason       String?
  voided_by         String?   @db.Uuid
  voided_at         DateTime? @db.Timestamptz
  created_at        DateTime  @default(now()) @db.Timestamptz

  // Relations
  order Order @relation(fields: [order_id], references: [id])

  @@unique([tenant_id, order_id, check_id])
  @@unique([tenant_id, series, invoice_number])
  @@index([tenant_id, created_at(sort: Desc)])
  @@map("invoices")
}

// ============================================================================
// CORE: Events (Append-Only)
// ============================================================================

model Event {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  occurred_at         DateTime @db.Timestamptz
  received_at         DateTime @default(now()) @db.Timestamptz
  type                String
  entity_type         String
  entity_id           String?  @db.Uuid
  actor_id            String?  @db.Uuid
  actor_role_snapshot String?
  terminal_id         String
  shift_id            String?  @db.Uuid
  payload_version     Int      @default(1)
  payload             Json

  @@index([tenant_id, occurred_at(sort: Desc)])
  @@index([tenant_id, entity_id])
  @@map("events")
}

// ============================================================================
// PROMOTIONS
// ============================================================================

model Promotion {
  id         String    @id @default(uuid()) @db.Uuid
  tenant_id  String    @db.Uuid
  code       String?
  name       String
  type       String // PERCENT|FIXED|HAPPY_HOUR|2X1|COMBO|DELIVERY_FEE_DISCOUNT
  value      Int?
  rules      Json // DSL rules
  starts_at  DateTime? @db.Timestamptz
  ends_at    DateTime? @db.Timestamptz
  is_active  Boolean   @default(true)
  stackable  Boolean   @default(false)
  priority   Int       @default(100)
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @default(now()) @db.Timestamptz

  // Relations
  orders  Order[]
  coupons Coupon[]

  @@index([tenant_id, is_active])
  @@map("promotions")
}

model DailySalesSummary {
  tenant_id          String   @db.Uuid
  business_date      DateTime @db.Date
  gross_sales_cents  Int      @default(0)
  net_sales_cents    Int      @default(0)
  discount_cents     Int      @default(0)
  tips_cents         Int      @default(0)
  delivery_fee_cents Int      @default(0)
  voids_cents        Int      @default(0)
  refunds_cents      Int      @default(0)
  orders_count       Int      @default(0)
  checks_count       Int      @default(0)
  payments_breakdown Json?
  created_at         DateTime @default(now()) @db.Timestamptz

  @@id([tenant_id, business_date])
  @@map("daily_sales_summary")
}

// ============================================================================
// PRINTING
// ============================================================================

model Printer {
  id              String  @id @default(uuid()) @db.Uuid
  tenant_id       String  @db.Uuid
  name            String
  station_id      String? @db.Uuid
  station_code    String
  connection_type String // USB|LAN|SERIAL
  connection      Json // {host, port} or {device_path}
  paper_width     Int     @default(80)
  is_active       Boolean @default(true)

  // Relations
  station    Station?   @relation(fields: [station_id], references: [id])
  print_jobs PrintJob[]

  @@index([tenant_id, station_code])
  @@map("printers")
}

model PrintJob {
  id          String    @id @default(uuid()) @db.Uuid
  tenant_id   String    @db.Uuid
  printer_id  String?   @db.Uuid
  job_type    String // KITCHEN_TICKET|RECEIPT|PRECHECK|SHIFT_REPORT
  priority    Int       @default(5)
  status      String    @default("QUEUED") // QUEUED|SENT|PRINTED|FAILED|CANCELLED
  attempts    Int       @default(0)
  payload     Json
  order_id    String?   @db.Uuid
  check_id    String?
  actor_id    String?   @db.Uuid
  terminal_id String?
  created_at  DateTime  @default(now()) @db.Timestamptz
  sent_at     DateTime? @db.Timestamptz
  printed_at  DateTime? @db.Timestamptz
  failed_at   DateTime? @db.Timestamptz

  // Relations
  printer Printer? @relation(fields: [printer_id], references: [id])

  @@index([tenant_id, status, created_at(sort: Desc)])
  @@map("print_jobs")
}

// ============================================================================
// GROWTH: Customers & Segmentation
// ============================================================================

model CustomerProfile {
  tenant_id            String    @db.Uuid
  customer_id          String    @unique @db.Uuid
  first_seen_at        DateTime? @db.Timestamptz
  last_seen_at         DateTime? @db.Timestamptz
  orders_count         Int       @default(0)
  invoices_count       Int       @default(0)
  lifetime_value_cents Int       @default(0)
  avg_ticket_cents     Int       @default(0)
  favorite_order_type  String?
  favorite_products    Json?
  recency_days         Int?
  frequency_30d        Int?
  is_birthday          Boolean   @default(false)
  updated_at           DateTime  @default(now()) @db.Timestamptz

  // Relations
  customer Customer @relation(fields: [customer_id], references: [id])

  @@id([tenant_id, customer_id])
  @@map("customer_profile")
}

model MarketingSegment {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  name       String
  definition Json // Rules DSL
  is_active  Boolean  @default(true)
  updated_at DateTime @default(now()) @db.Timestamptz

  // Relations
  members   SegmentMember[]
  campaigns MarketingCampaign[]

  @@index([tenant_id, is_active])
  @@map("marketing_segments")
}

model SegmentMember {
  tenant_id   String   @db.Uuid
  segment_id  String   @db.Uuid
  customer_id String   @db.Uuid
  computed_at DateTime @default(now()) @db.Timestamptz

  // Relations
  segment MarketingSegment @relation(fields: [segment_id], references: [id])

  @@id([tenant_id, segment_id, customer_id])
  @@map("segment_members")
}

// ============================================================================
// GROWTH: Campaigns & Messaging
// ============================================================================

model MarketingCampaign {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  name                String
  channel             String // WHATSAPP|SMS|EMAIL|IN_APP
  segment_id          String?  @db.Uuid
  message_template_id String?  @db.Uuid
  offer               Json?
  schedule            Json?
  status              String   @default("DRAFT") // DRAFT|SCHEDULED|RUNNING|PAUSED|COMPLETED
  created_by          String?  @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz
  updated_at          DateTime @default(now()) @db.Timestamptz

  // Relations
  segment  MarketingSegment? @relation(fields: [segment_id], references: [id])
  template MessageTemplate?  @relation(fields: [message_template_id], references: [id])
  messages MessageOutbox[]

  @@index([tenant_id, status])
  @@map("marketing_campaigns")
}

model MessageTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  channel          String
  name             String
  language         String   @default("es_PE")
  template_key     String?
  content          String
  variables_schema Json?
  is_active        Boolean  @default(true)
  updated_at       DateTime @default(now()) @db.Timestamptz

  // Relations
  campaigns MarketingCampaign[]

  @@index([tenant_id, channel, is_active])
  @@map("message_templates")
}

model MessageOutbox {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  channel             String
  customer_id         String?   @db.Uuid
  to_phone            String
  campaign_id         String?   @db.Uuid
  template_id         String?   @db.Uuid
  payload             Json
  status              String    @default("QUEUED") // QUEUED|SENT|DELIVERED|FAILED|CANCELLED
  attempts            Int       @default(0)
  last_error          String?
  scheduled_at        DateTime? @db.Timestamptz
  sent_at             DateTime? @db.Timestamptz
  provider_message_id String?
  created_at          DateTime  @default(now()) @db.Timestamptz

  // Relations
  campaign MarketingCampaign? @relation(fields: [campaign_id], references: [id])

  @@index([tenant_id, status, scheduled_at])
  @@map("message_outbox")
}

// ============================================================================
// GROWTH: AI Suggestions
// ============================================================================

model AiSuggestion {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  type       String // UPSELL|PROMO_SUGGESTION|FORECAST
  context    Json?
  suggestion Json
  confidence Float?
  status     String   @default("DRAFT") // DRAFT|APPROVED|REJECTED|APPLIED
  created_at DateTime @default(now()) @db.Timestamptz
  created_by String   @default("SYSTEM")

  @@index([tenant_id, status])
  @@map("ai_suggestions")
}

// ============================================================================
// SECURITY: Coupons & Redemptions
// ============================================================================

model Coupon {
  id                      String    @id @default(uuid()) @db.Uuid
  tenant_id               String    @db.Uuid
  code                    String
  promotion_id            String?   @db.Uuid
  customer_id             String?   @db.Uuid
  issued_at               DateTime  @default(now()) @db.Timestamptz
  expires_at              DateTime? @db.Timestamptz
  status                  String    @default("ACTIVE") // ACTIVE|RESERVED|REDEEMED|EXPIRED|VOIDED
  reserved_at             DateTime? @db.Timestamptz
  reserved_by_terminal_id String?
  redeemed_at             DateTime? @db.Timestamptz
  redeemed_order_id       String?   @db.Uuid
  redeemed_check_id       String?
  void_reason             String?
  created_at              DateTime  @default(now()) @db.Timestamptz

  // Relations
  promotion   Promotion?         @relation(fields: [promotion_id], references: [id])
  customer    Customer?          @relation(fields: [customer_id], references: [id])
  redemptions CouponRedemption[]

  @@unique([tenant_id, code])
  @@index([tenant_id, status, expires_at])
  @@index([tenant_id, customer_id, status])
  @@map("coupons")
}

model CouponRedemption {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  coupon_id   String   @db.Uuid
  code        String
  action      String // ISSUED|RESERVED|RESERVE_CANCELLED|REDEEMED|VOIDED
  order_id    String?  @db.Uuid
  check_id    String?
  actor_id    String?  @db.Uuid
  terminal_id String
  occurred_at DateTime @default(now()) @db.Timestamptz
  payload     Json?

  // Relations
  coupon Coupon @relation(fields: [coupon_id], references: [id])

  @@index([tenant_id, coupon_id, occurred_at(sort: Desc)])
  @@map("coupon_redemptions")
}

// ============================================================================
// SECURITY: Sync Conflicts
// ============================================================================

model SyncConflict {
  id          String    @id @default(uuid()) @db.Uuid
  tenant_id   String    @db.Uuid
  entity_type String // coupon|order|payment
  entity_id   String?   @db.Uuid
  severity    String    @default("WARN") // INFO|WARN|BLOCKING
  detected_at DateTime  @default(now()) @db.Timestamptz
  details     Json
  resolved_by String?   @db.Uuid
  resolved_at DateTime? @db.Timestamptz
  resolution  Json?

  @@index([tenant_id, severity])
  @@map("sync_conflicts")
}

// ============================================================================
// OPTIONAL: Inventory
// ============================================================================

model Inventory {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String   @db.Uuid
  code       String
  name       String
  unit       String
  stock      Decimal  @default(0) @db.Decimal(10, 3)
  min_stock  Decimal? @db.Decimal(10, 3)
  cost_cents Int?
  updated_at DateTime @default(now()) @db.Timestamptz

  // Relations
  logs InventoryLog[]

  @@unique([tenant_id, code])
  @@map("inventory")
}

model InventoryLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenant_id     String   @db.Uuid
  inventory_id  String   @db.Uuid
  movement_type String // IN|OUT|ADJUST|WASTE
  quantity      Decimal  @db.Decimal(10, 3)
  reference_id  String?  @db.Uuid
  reason        String?
  actor_id      String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz

  // Relations
  inventory Inventory @relation(fields: [inventory_id], references: [id])

  @@index([tenant_id, inventory_id, created_at(sort: Desc)])
  @@map("inventory_log")
}

// ============================================================================
// INVENTORY: Extended (Suppliers, Recipes, Alerts, Transfers)
// ============================================================================

model Supplier {
  id              String   @id @default(uuid()) @db.Uuid
  tenant_id       String   @db.Uuid
  name            String
  ruc             String?
  contact_name    String?
  phone           String?
  email           String?
  address         String?
  payment_terms   Int      @default(0) // Days of credit
  min_order_cents Int      @default(0)
  delivery_days   String[] @default([]) // ["LUNES", "MIERCOLES"]
  lead_time_days  Int      @default(1)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz
  updated_at      DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id, is_active])
  @@map("suppliers")
}

model Recipe {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  product_id   String   @db.Uuid
  ingredients  Json // Array of {sku, quantity, unit, is_optional, substitutes}
  yield_qty    Decimal  @default(1) @db.Decimal(10, 3)
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, product_id])
  @@map("recipes")
}

model StockAlert {
  id                 String    @id @default(uuid()) @db.Uuid
  tenant_id          String    @db.Uuid
  location_id        String    @db.Uuid
  sku                String
  alert_type         String // LOW_STOCK|OUT_OF_STOCK|EXPIRING_SOON|OVERSTOCK
  severity           String    @default("MEDIUM") // LOW|MEDIUM|HIGH|CRITICAL
  current_qty        Decimal   @db.Decimal(10, 3)
  threshold_qty      Decimal   @db.Decimal(10, 3)
  is_acknowledged    Boolean   @default(false)
  acknowledged_by    String?   @db.Uuid
  acknowledged_at    DateTime? @db.Timestamptz
  created_at         DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, location_id, is_acknowledged])
  @@map("stock_alerts")
}

model StockTransfer {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  from_location_id String    @db.Uuid
  to_location_id   String    @db.Uuid
  status           String    @default("PENDING") // PENDING|IN_TRANSIT|RECEIVED|CANCELLED
  items            Json // Array of {sku, quantity, unit_cost}
  transport_cost   Int       @default(0) // centavos
  authorized_by    String    @db.Uuid
  received_by      String?   @db.Uuid
  shipped_at       DateTime? @db.Timestamptz
  received_at      DateTime? @db.Timestamptz
  notes            String?
  created_at       DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, status])
  @@map("stock_transfers")
}

// ============================================================================
// TABLES & ZONES (Floor Plan)
// ============================================================================

model Zone {
  id                  String   @id @default(uuid()) @db.Uuid
  tenant_id           String   @db.Uuid
  location_id         String   @db.Uuid
  code                String // "A", "BAR", "TERRAZA"
  name                String
  color               String   @default("#4CAF50")
  bounds              Json? // {x, y, width, height}
  is_smoking          Boolean  @default(false)
  is_outdoor          Boolean  @default(false)
  has_ac              Boolean  @default(false)
  assigned_waiter_ids String[] @default([])
  sort_order          Int      @default(0)
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamptz

  // Relations
  tables Table[]

  @@unique([tenant_id, location_id, code])
  @@map("zones")
}

model Table {
  id               String    @id @default(uuid()) @db.Uuid
  tenant_id        String    @db.Uuid
  location_id      String    @db.Uuid
  zone_id          String?   @db.Uuid
  number           String // "5", "5-6-7", "T1"
  display_name     String?
  capacity         Int       @default(4)
  position_x       Int       @default(0)
  position_y       Int       @default(0)
  width            Int       @default(60)
  height           Int       @default(60)
  rotation         Int       @default(0)
  shape            String    @default("SQUARE") // SQUARE|ROUND|RECTANGLE
  status           String    @default("AVAILABLE") // AVAILABLE|OCCUPIED|RESERVED|CLEANING|BLOCKED
  current_order_id String?   @db.Uuid
  occupied_since   DateTime? @db.Timestamptz
  is_merged        Boolean   @default(false)
  merged_table_ids String[]  @default([])
  parent_table_id  String?   @db.Uuid
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @default(now()) @db.Timestamptz

  // Relations
  zone         Zone?         @relation(fields: [zone_id], references: [id])
  reservations Reservation[]

  @@unique([tenant_id, location_id, number])
  @@index([tenant_id, location_id, status])
  @@map("tables")
}

model TableLayout {
  id                   String   @id @default(uuid()) @db.Uuid
  tenant_id            String   @db.Uuid
  location_id          String   @db.Uuid
  name                 String
  is_active            Boolean  @default(true)
  canvas_width         Int      @default(800)
  canvas_height        Int      @default(600)
  background_image_url String?
  background_opacity   Int      @default(50)
  decorations          Json     @default("[]") // Array of decoration objects
  created_at           DateTime @default(now()) @db.Timestamptz
  updated_at           DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id, location_id, is_active])
  @@map("table_layouts")
}

// ============================================================================
// RESERVATIONS & WAITLIST
// ============================================================================

model Reservation {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  location_id         String    @db.Uuid
  customer_name       String
  customer_phone      String
  customer_email      String?
  customer_id         String?   @db.Uuid
  date                DateTime  @db.Date
  time                String // "20:00"
  duration_minutes    Int       @default(90)
  party_size          Int
  table_id            String?   @db.Uuid
  table_number        String?
  zone_preference     String?
  status              String    @default("PENDING") // PENDING|PENDING_DEPOSIT|CONFIRMED|WAITLIST|SEATED|COMPLETED|NO_SHOW|CANCELLED
  confirmation_sent   DateTime? @db.Timestamptz
  confirmed_at        DateTime? @db.Timestamptz
  confirmed_via       String? // WHATSAPP|PHONE|EMAIL
  deposit_required    Boolean   @default(false)
  deposit_amount      Int? // centavos
  deposit_paid_at     DateTime? @db.Timestamptz
  deposit_payment_id  String?
  special_requests    String?
  internal_notes      String?
  arrived_at          DateTime? @db.Timestamptz
  seated_at           DateTime? @db.Timestamptz
  no_show_at          DateTime? @db.Timestamptz
  cancelled_at        DateTime? @db.Timestamptz
  cancelled_reason    String?
  created_by          String    @db.Uuid
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @default(now()) @db.Timestamptz

  // Relations
  table Table? @relation(fields: [table_id], references: [id])

  @@index([tenant_id, location_id, date, status])
  @@index([tenant_id, customer_phone])
  @@map("reservations")
}

model Waitlist {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  location_id    String    @db.Uuid
  customer_name  String
  customer_phone String
  date           DateTime  @db.Date
  preferred_time String
  party_size     Int
  position       Int
  notified_at    DateTime? @db.Timestamptz
  expires_at     DateTime? @db.Timestamptz
  status         String    @default("WAITING") // WAITING|NOTIFIED|CONVERTED|EXPIRED
  created_at     DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, location_id, date, status])
  @@map("waitlist")
}

// ============================================================================
// PETTY CASH (Caja Chica)
// ============================================================================

model PettyCashTransaction {
  id                String    @id @default(uuid()) @db.Uuid
  tenant_id         String    @db.Uuid
  location_id       String    @db.Uuid
  shift_id          String    @db.Uuid
  type              String // WITHDRAWAL|DEPOSIT
  amount            Int // centavos (always positive)
  category          String // COMPRA_EMERGENCIA|TRANSPORTE|LIMPIEZA|MANTENIMIENTO|PROPINA_DELIVERY|OTROS
  description       String
  requires_approval Boolean   @default(false)
  approved_by       String?   @db.Uuid
  approved_at       DateTime? @db.Timestamptz
  receipt_photo_url String?
  receipt_number    String?
  supplier_name     String?
  created_by        String    @db.Uuid
  created_at        DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, location_id, shift_id])
  @@map("petty_cash_transactions")
}

model PettyCashBalance {
  id                 String   @id @default(uuid()) @db.Uuid
  tenant_id          String   @db.Uuid
  location_id        String   @db.Uuid
  current_balance    Int      @default(0) // centavos
  max_balance        Int      @default(50000) // S/500
  min_balance        Int      @default(10000) // S/100
  approval_threshold Int      @default(5000) // S/50
  last_reconciled_at DateTime @default(now()) @db.Timestamptz
  last_reconciled_by String?  @db.Uuid
  updated_at         DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, location_id])
  @@map("petty_cash_balance")
}

// ============================================================================
// TIPS (Propinas)
// ============================================================================

model Tip {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  location_id    String    @db.Uuid
  order_id       String    @db.Uuid
  shift_id       String    @db.Uuid
  amount         Int // centavos
  payment_method String // CASH|CARD|TRANSFER
  waiter_id      String    @db.Uuid
  zone_id        String?   @db.Uuid
  status         String    @default("RECEIVED") // RECEIVED|PENDING_SETTLEMENT|SETTLED|DISTRIBUTED
  settled_at     DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, shift_id, waiter_id])
  @@map("tips")
}

model TipDistribution {
  id                String   @id @default(uuid()) @db.Uuid
  tenant_id         String   @db.Uuid
  location_id       String   @db.Uuid
  shift_id          String   @db.Uuid
  distribution_mode String // INDIVIDUAL|POOL_EQUAL|POOL_BY_HOURS|BY_ZONE
  total_tips        Int // centavos
  participants      Int
  distributions     Json // Array of {employee_id, amount, zone_id?}
  distributed_by    String   @db.Uuid
  distributed_at    DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id, shift_id])
  @@map("tip_distributions")
}

model TipConfig {
  id                      String  @id @default(uuid()) @db.Uuid
  tenant_id               String  @db.Uuid
  location_id             String  @db.Uuid
  distribution_mode       String  @default("INDIVIDUAL")
  include_kitchen         Boolean @default(false)
  kitchen_percentage      Int     @default(0)
  card_tip_fee_percentage Int     @default(0)
  min_tip_to_record       Int     @default(100) // S/1

  @@unique([tenant_id, location_id])
  @@map("tip_config")
}

// ============================================================================
// EMPLOYEES: Extended (Schedules, Attendance, Time Off)
// ============================================================================

model Schedule {
  id                   String    @id @default(uuid()) @db.Uuid
  tenant_id            String    @db.Uuid
  location_id          String    @db.Uuid
  employee_id          String    @db.Uuid
  date                 DateTime  @db.Date
  shift_start          String // "12:00"
  shift_end            String // "22:00"
  break_minutes        Int       @default(60)
  zone_id              String?   @db.Uuid
  status               String    @default("SCHEDULED") // SCHEDULED|SWAP_PENDING|SWAP_APPROVED|CANCELLED|COMPLETED
  original_employee_id String?   @db.Uuid
  swap_approved_by     String?   @db.Uuid
  notes                String?
  created_by           String    @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz
  updated_at           DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, location_id, date])
  @@index([tenant_id, employee_id, date])
  @@map("schedules")
}

model Attendance {
  id                  String    @id @default(uuid()) @db.Uuid
  tenant_id           String    @db.Uuid
  location_id         String    @db.Uuid
  employee_id         String    @db.Uuid
  schedule_id         String?   @db.Uuid
  date                DateTime  @db.Date
  clock_in            DateTime  @db.Timestamptz
  clock_out           DateTime? @db.Timestamptz
  breaks              Json      @default("[]") // Array of {start, end, type}
  scheduled_minutes   Int       @default(0)
  worked_minutes      Int       @default(0)
  overtime_minutes    Int       @default(0)
  late_minutes        Int       @default(0)
  early_leave_minutes Int       @default(0)
  status              String    @default("PRESENT") // PRESENT|ON_BREAK|COMPLETED|ABSENT|LATE|EXCUSED
  notes               String?
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, employee_id, date])
  @@map("attendance")
}

model TimeOffRequest {
  id           String    @id @default(uuid()) @db.Uuid
  tenant_id    String    @db.Uuid
  employee_id  String    @db.Uuid
  type         String // VACATION|SICK|PERSONAL|BEREAVEMENT|MATERNITY|OTHER
  start_date   DateTime  @db.Date
  end_date     DateTime  @db.Date
  reason       String
  status       String    @default("PENDING") // PENDING|APPROVED|REJECTED
  reviewed_by  String?   @db.Uuid
  reviewed_at  DateTime? @db.Timestamptz
  review_notes String?
  created_at   DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, employee_id, status])
  @@map("time_off_requests")
}

// ============================================================================
// INVOICING: Extended (SUNAT Queue, CDR, Daily Summary)
// ============================================================================

model InvoiceQueue {
  id              String    @id @default(uuid()) @db.Uuid
  tenant_id       String    @db.Uuid
  invoice_id      String    @db.Uuid
  action          String // SEND|VOID|SUMMARY|QUERY_CDR
  priority        Int       @default(5)
  attempts        Int       @default(0)
  max_attempts    Int       @default(3)
  last_attempt_at DateTime? @db.Timestamptz
  last_error      String?
  scheduled_at    DateTime  @default(now()) @db.Timestamptz
  processed_at    DateTime? @db.Timestamptz
  status          String    @default("PENDING") // PENDING|PROCESSING|COMPLETED|FAILED

  @@index([tenant_id, status, scheduled_at])
  @@map("invoice_queue")
}

model InvoiceCDR {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  invoice_id       String   @db.Uuid
  response_code    String
  response_message String
  hash             String?
  cdr_xml          String? // Compressed CDR XML
  received_at      DateTime @default(now()) @db.Timestamptz

  @@unique([tenant_id, invoice_id])
  @@map("invoice_cdr")
}

model SunatDailySummary {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  location_id    String    @db.Uuid
  summary_date   DateTime  @db.Date
  summary_number String // RC-20260105-001
  boletas_count  Int       @default(0)
  boletas_total  Int       @default(0) // centavos
  ticket_number  String?
  sunat_status   String    @default("PENDING")
  cdr_received   DateTime? @db.Timestamptz
  created_at     DateTime  @default(now()) @db.Timestamptz

  @@unique([tenant_id, location_id, summary_date])
  @@map("sunat_daily_summary")
}

// ============================================================================
// REFUNDS (Devoluciones)
// ============================================================================

model Refund {
  id                   String    @id @default(uuid()) @db.Uuid
  tenant_id            String    @db.Uuid
  order_id             String    @db.Uuid
  check_id             String
  invoice_id           String?   @db.Uuid
  type                 String // FULL|PARTIAL|VOID
  status               String    @default("REQUESTED") // REQUESTED|AUTHORIZED|ISSUED|REJECTED
  reason_code          String // PRODUCT_DEFECTIVE|WRONG_PRODUCT|CASHIER_ERROR|CUSTOMER_CANCELLED|EXCESSIVE_WAIT|OTHER
  reason_detail        String?
  requested_by         String    @db.Uuid
  authorized_by        String?   @db.Uuid
  original_amount      Int // centavos
  refund_amount        Int // centavos
  refund_method        String // CASH|CARD|YAPE|PLIN
  refund_reference     String?
  items                Json? // Array of {line_id, qty, amount}
  credit_note_id       String?   @db.Uuid
  created_at           DateTime  @default(now()) @db.Timestamptz
  authorized_at        DateTime? @db.Timestamptz
  issued_at            DateTime? @db.Timestamptz

  @@index([tenant_id, order_id])
  @@index([tenant_id, status])
  @@map("refunds")
}

// ============================================================================
// DELIVERY: Extended (Zones, Customers)
// ============================================================================

model DeliveryZone {
  id               String   @id @default(uuid()) @db.Uuid
  tenant_id        String   @db.Uuid
  location_id      String   @db.Uuid
  name             String
  type             String   @default("RADIUS") // RADIUS|POLYGON
  center_lat       Decimal? @db.Decimal(10, 7)
  center_lng       Decimal? @db.Decimal(10, 7)
  radius_km        Decimal? @db.Decimal(5, 2)
  polygon          Json? // Array of {lat, lng}
  delivery_fee     Int      @default(0) // centavos
  min_order        Int      @default(0) // centavos
  estimated_mins   Int      @default(30)
  is_active        Boolean  @default(true)
  priority         Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id, location_id, is_active])
  @@map("delivery_zones")
}

model DeliveryAddress {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @db.Uuid
  customer_id  String   @db.Uuid
  label        String? // "Casa", "Oficina"
  address_text String
  reference    String?
  district     String?
  lat          Decimal? @db.Decimal(10, 7)
  lng          Decimal? @db.Decimal(10, 7)
  zone_id      String?  @db.Uuid
  delivery_fee Int      @default(0) // centavos
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz

  // Relations
  customer Customer @relation(fields: [customer_id], references: [id])

  @@index([tenant_id, customer_id])
  @@map("delivery_addresses")
}

model DeliveryOrder {
  id                    String    @id @default(uuid()) @db.Uuid
  tenant_id             String    @db.Uuid
  order_id              String    @db.Uuid
  driver_id             String?   @db.Uuid
  address_id            String?   @db.Uuid
  address_text          String
  address_reference     String?
  customer_phone        String
  delivery_fee          Int       @default(0) // centavos
  estimated_delivery_at DateTime? @db.Timestamptz
  assigned_at           DateTime? @db.Timestamptz
  dispatched_at         DateTime? @db.Timestamptz
  delivered_at          DateTime? @db.Timestamptz
  failed_at             DateTime? @db.Timestamptz
  failure_reason        String?
  delivery_time_mins    Int?
  signature_url         String?
  status                String    @default("PENDING") // PENDING|ASSIGNED|DISPATCHED|DELIVERED|FAILED
  created_at            DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, status])
  @@index([tenant_id, driver_id, status])
  @@map("delivery_orders")
}


// ============================================================================
// SYNC: Event Outbox (Garantiza publicación de eventos)
// ============================================================================

model EventOutbox {
  id           String    @id @default(uuid()) @db.Uuid
  tenant_id    String    @db.Uuid
  event_id     String    @db.Uuid
  payload      Json
  published    Boolean   @default(false)
  published_at DateTime? @db.Timestamptz
  attempts     Int       @default(0)
  last_error   String?
  created_at   DateTime  @default(now()) @db.Timestamptz

  @@index([tenant_id, published, created_at])
  @@map("event_outbox")
}


// ============================================================================
// SYNC: Processed Events (Idempotencia en Proyecciones)
// ============================================================================

model ProcessedEvent {
  event_id     String   @id @db.Uuid
  tenant_id    String   @db.Uuid
  processed_at DateTime @default(now()) @db.Timestamptz

  @@index([tenant_id, processed_at])
  @@map("processed_events")
}


// ============================================================================
// SYNC: Terminal Number Ranges (Evita colisiones de order_number)
// ============================================================================

model TerminalNumberRange {
  terminal_id    String @id
  tenant_id      String @db.Uuid
  range_start    Int
  range_end      Int
  current_number Int

  @@unique([tenant_id, range_start])
  @@map("terminal_number_ranges")
}
