  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String    @db.Uuid
  employee_id       String    @db.Uuid
  evaluator_id      String    @db.Uuid
  period_start      DateTime  @db.Date
  period_end        DateTime  @db.Date
  scores            Json
  automatic_metrics Json
  comments          String?
  employee_comments String?
  goals             Json?
  status            String    @default("DRAFT")
  completed_at      DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  employee          employees @relation(fields: [employee_id], references: [id])
  tenants           tenants   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, employee_id, period_end(sort: Desc)])
  @@index([tenant_id, status])
}

/// Registros de capacitaciones
/// Almacena capacitaciones completadas por empleados
model training_records {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  employee_id     String    @db.Uuid
  training_name   String
  training_type   String
  provider        String?
  duration_hours  Int?
  completion_date DateTime  @db.Date
  certificate_url String?
  score           Int?
  notes           String?
  assigned_by     String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  employee        employees @relation(fields: [employee_id], references: [id])
  tenants         tenants   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, employee_id, completion_date(sort: Desc)])
  @@index([tenant_id, training_type])
}

/// Registros de planilla mensual
/// Almacena el cálculo de planilla de cada empleado por mes
model payroll_records {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id              String    @db.Uuid
  employee_id            String    @db.Uuid
  period_month           String
  business_date_start    DateTime  @db.Date
  business_date_end      DateTime  @db.Date
  base_salary_cents      Int
  commission_cents       Int       @default(0)
  tips_cents             Int       @default(0)
  overtime_cents         Int       @default(0)
  bonuses_cents          Int       @default(0)
  advances_cents         Int       @default(0)
  absences_cents         Int       @default(0)
  other_deductions_cents Int       @default(0)
  essalud_cents          Int
  pension_cents          Int
  gross_salary_cents     Int
  net_salary_cents       Int
  days_worked            Int
  hours_worked           Int
  overtime_hours         Int
  absences_count         Int
  payslip_url            String?
  calculated_by          String    @db.Uuid
  calculated_at          DateTime  @default(now()) @db.Timestamptz(6)
  paid_at                DateTime? @db.Timestamptz(6)
  employee               employees @relation(fields: [employee_id], references: [id])
  tenants                tenants   @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, employee_id, period_month])
  @@index([tenant_id, period_month])
  @@index([tenant_id, employee_id, period_month(sort: Desc)])
}

model platform_configs {
  id              String   @id @db.Uuid
  tenant_id       String   @db.Uuid
  platform        String
  is_active       Boolean  @default(true)
  api_key         String?
  store_id        String?
  webhook_secret  String?
  commission_rate Decimal  @db.Decimal(5, 2)
  markup_rate     Decimal  @default(0.20) @db.Decimal(5, 2)
  auto_accept     Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  tenants         tenants  @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, platform])
  @@index([tenant_id, is_active])
}

model platform_orders {
  id                     String    @id @db.Uuid
  tenant_id              String    @db.Uuid
  platform               String
  platform_order_id      String
  order_id               String?   @db.Uuid
  status                 String    @default("RECEIVED")
  raw_payload            Json
  customer_name          String?
  customer_phone         String?
  delivery_address       String?
  platform_total_cents   Int
  restaurant_total_cents Int
  commission_cents       Int       @default(0)
  items                  Json
  notes                  String?
  estimated_pickup       DateTime? @db.Timestamptz(6)
  accepted_at            DateTime? @db.Timestamptz(6)
  rejected_at            DateTime? @db.Timestamptz(6)
  rejection_reason       String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  orders                 orders?   @relation(fields: [order_id], references: [id])
  tenants                tenants   @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, platform, platform_order_id])
  @@index([tenant_id, status])
  @@index([tenant_id, created_at(sort: Desc)])
  @@index([order_id])
}

model payment_settlements {
  id               String    @id @db.Uuid
  tenant_id        String    @db.Uuid
  period_start     DateTime  @db.Date
  period_end       DateTime  @db.Date
  payment_method   String
  expected_cents   Int
  received_cents   Int?
  difference_cents Int?
  status           String    @default("PENDING")
  notes            String?
  reconciled_by    String?   @db.Uuid
  reconciled_at    DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  tenants          tenants   @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, period_start, period_end, payment_method])
  @@index([tenant_id, status])
}
