generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model admin_access_logs {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  employee_id String   @db.Uuid
  action      String
  resource    String?
  ip_address  String?
  user_agent  String?
  terminal_id String?
  metadata    Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  tenants     tenants  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, action, created_at(sort: Desc)])
  @@index([tenant_id, employee_id, created_at(sort: Desc)])
}

model ai_suggestions {
  id         String   @id @db.Uuid
  tenant_id  String   @db.Uuid
  type       String
  context    Json?
  suggestion Json
  confidence Float?
  status     String   @default("DRAFT")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  created_by String   @default("SYSTEM")
  tenants    tenants  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, status])
}

model attendance {
  id                  String    @id @db.Uuid
  tenant_id           String    @db.Uuid
  location_id         String    @db.Uuid
  employee_id         String    @db.Uuid
  schedule_id         String?   @db.Uuid
  date                DateTime  @db.Date
  clock_in            DateTime  @db.Timestamptz(6)
  clock_out           DateTime? @db.Timestamptz(6)
  breaks              Json      @default("[]")
  scheduled_minutes   Int       @default(0)
  worked_minutes      Int       @default(0)
  overtime_minutes    Int       @default(0)
  late_minutes        Int       @default(0)
  early_leave_minutes Int       @default(0)
  status              String    @default("PRESENT")
  notes               String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)
  tenants             tenants   @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, employee_id, date])
}

model catalog_meta {
  tenant_id       String   @id @db.Uuid
  catalog_version Int      @default(1)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  tenants         tenants  @relation(fields: [tenant_id], references: [id])
}

model conflict_logs {
  id                String   @id @db.Uuid
  tenant_id         String   @db.Uuid
  aggregate_type    String
  aggregate_id      String   @db.Uuid
  conflict_type     String
  resolution        String
  event_id          String   @db.Uuid
  expected_revision Int
  actual_revision   Int
  local_state       Json?
  server_state      Json?
  merged_state      Json?
  terminal_id       String
  resolved_by       String?  @db.Uuid
  resolved_at       DateTime @default(now()) @db.Timestamptz(6)
  tenants           tenants  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, aggregate_id, resolved_at(sort: Desc)])
  @@index([tenant_id, conflict_type])
}

model coupon_redemptions {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  coupon_id   String   @db.Uuid
  code        String
  action      String
  order_id    String?  @db.Uuid
  check_id    String?
  actor_id    String?  @db.Uuid
  terminal_id String
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  payload     Json?
  coupons     coupons  @relation(fields: [coupon_id], references: [id])
  tenants     tenants  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, coupon_id, occurred_at(sort: Desc)])
  @@index([order_id])
}

model coupons {
  id                      String               @id @db.Uuid
  tenant_id               String               @db.Uuid
  code                    String
  promotion_id            String?              @db.Uuid
  customer_id             String?              @db.Uuid
  issued_at               DateTime             @default(now()) @db.Timestamptz(6)
  expires_at              DateTime?            @db.Timestamptz(6)
  status                  String               @default("ACTIVE")
  reserved_at             DateTime?            @db.Timestamptz(6)
  reserved_by_terminal_id String?
  redeemed_at             DateTime?            @db.Timestamptz(6)
  redeemed_order_id       String?              @db.Uuid
  redeemed_check_id       String?
  void_reason             String?
  created_at              DateTime             @default(now()) @db.Timestamptz(6)
  coupon_redemptions      coupon_redemptions[]
  customers               customers?           @relation(fields: [customer_id], references: [id])
  promotions              promotions?          @relation(fields: [promotion_id], references: [id])
  tenants                 tenants              @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, code])
  @@index([tenant_id, customer_id, status])
  @@index([tenant_id, status, expires_at])
  @@index([tenant_id, promotion_id], map: "coupons_promotion_id_idx")
}

model customer_profile {
  tenant_id            String    @db.Uuid
  customer_id          String    @unique @db.Uuid
  first_seen_at        DateTime? @db.Timestamptz(6)
  last_seen_at         DateTime? @db.Timestamptz(6)
  orders_count         Int       @default(0)
  invoices_count       Int       @default(0)
  lifetime_value_cents Int       @default(0)
  avg_ticket_cents     Int       @default(0)
  favorite_order_type  String?
  favorite_products    Json?
  recency_days         Int?
  frequency_30d        Int?
  is_birthday          Boolean   @default(false)
  updated_at           DateTime  @default(now()) @db.Timestamptz(6)
  customers            customers @relation(fields: [customer_id], references: [id])
  tenants              tenants   @relation(fields: [tenant_id], references: [id])

  @@id([tenant_id, customer_id])
}

model customers {
  id                 String               @id @db.Uuid
  tenant_id          String               @db.Uuid
  phone              String
  name               String?
  addresses          Json                 @default("[]")
  birth_month        Int?
  birth_day          Int?
  marketing_opt_in   Boolean              @default(true)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  email              String?
  last_order_at      DateTime?            @db.Timestamptz(6)
  notes              String?
  total_orders       Int                  @default(0)
  total_spent        Int                  @default(0)
  coupons            coupons[]
  customer_profile   customer_profile?
  tenants            tenants              @relation(fields: [tenant_id], references: [id])
  delivery_addresses delivery_addresses[]
  orders             orders[]

  @@unique([tenant_id, phone])
}

model daily_sales_summary {
  tenant_id          String   @db.Uuid
  business_date      DateTime @db.Date
  gross_sales_cents  Int      @default(0)
  net_sales_cents    Int      @default(0)
  discount_cents     Int      @default(0)
  tips_cents         Int      @default(0)
  delivery_fee_cents Int      @default(0)
  voids_cents        Int      @default(0)
  refunds_cents      Int      @default(0)
  orders_count       Int      @default(0)
  checks_count       Int      @default(0)
  payments_breakdown Json?
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  tenants            tenants  @relation(fields: [tenant_id], references: [id])

  @@id([tenant_id, business_date])
}

model delivery_addresses {
  id              String            @id @db.Uuid
  tenant_id       String            @db.Uuid
  customer_id     String            @db.Uuid
  label           String?
  address_text    String
  reference       String?
  district        String?
  lat             Decimal?          @db.Decimal(10, 7)
  lng             Decimal?          @db.Decimal(10, 7)
  zone_id         String?           @db.Uuid
  delivery_fee    Int               @default(0)
  is_default      Boolean           @default(false)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  customers       customers         @relation(fields: [customer_id], references: [id])
  tenants         tenants           @relation(fields: [tenant_id], references: [id])
  delivery_orders delivery_orders[]

  @@index([tenant_id, customer_id])
}

model delivery_orders {
  id                    String              @id @db.Uuid
  tenant_id             String              @db.Uuid
  order_id              String              @db.Uuid
  driver_id             String?             @db.Uuid
  address_id            String?             @db.Uuid
  address_text          String
  address_reference     String?
  customer_phone        String
  delivery_fee          Int                 @default(0)
  estimated_delivery_at DateTime?           @db.Timestamptz(6)
  assigned_at           DateTime?           @db.Timestamptz(6)
  dispatched_at         DateTime?           @db.Timestamptz(6)
  delivered_at          DateTime?           @db.Timestamptz(6)
  failed_at             DateTime?           @db.Timestamptz(6)
  failure_reason        String?
  delivery_time_mins    Int?
  signature_url         String?
  status                String              @default("PENDING")
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  assignment_logs       assignment_logs[]
  delivery_addresses    delivery_addresses? @relation(fields: [address_id], references: [id])
  drivers               drivers?            @relation(fields: [driver_id], references: [id])
  orders                orders              @relation(fields: [order_id], references: [id])
  tenants               tenants             @relation(fields: [tenant_id], references: [id])
  eta_predictions       eta_predictions[]
  whatsapp_messages     whatsapp_messages[]

  @@index([tenant_id, driver_id, status])
  @@index([tenant_id, status])
  @@index([order_id])
  @@index([address_id])
}

model delivery_zones {
  id             String    @id @db.Uuid
  tenant_id      String    @db.Uuid
  location_id    String    @db.Uuid
  name           String
  type           String    @default("RADIUS")
  center_lat     Decimal?  @db.Decimal(10, 7)
  center_lng     Decimal?  @db.Decimal(10, 7)
  radius_km      Decimal?  @db.Decimal(5, 2)
  polygon        Json?
  delivery_fee   Int       @default(0)
  min_order      Int       @default(0)
  estimated_mins Int       @default(30)
  is_active      Boolean   @default(true)
  priority       Int       @default(0)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  locations      locations @relation(fields: [location_id], references: [id])
  tenants        tenants   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, location_id, is_active])
}

model drivers {
  id               String             @id @db.Uuid
  tenant_id        String             @db.Uuid
  name             String
  phone            String?
  is_active        Boolean            @default(true)
  assignment_logs  assignment_logs[]
  delivery_orders  delivery_orders[]
  tenants          tenants            @relation(fields: [tenant_id], references: [id])
  location_history location_history[]

  @@index([tenant_id, is_active])
}

model employees {
  id                                 String                    @id @db.Uuid
  tenant_id                          String                    @db.Uuid
  name                               String
  role                               String
  pin_hash                           String?
  is_active                          Boolean                   @default(true)
  created_at                         DateTime                  @default(now()) @db.Timestamptz(6)
  dni                                String?
  email                              String?
  phone                              String?
  address                            String?
  birth_date                         DateTime?                 @db.Date
  profile_photo_url                  String?
  hire_date                          DateTime?                 @db.Date
  position                           String?
  base_salary_cents                  Int?
  contract_type                      String?
  work_schedule_type                 String?
  location_id                        String?                   @db.Uuid
  commission_rate                    Decimal?                  @db.Decimal(5, 2)
  pension_system                     String?
  has_health_insurance               Boolean                   @default(false)
  advances                           advances[]
  emergency_contacts                 emergency_contacts[]
  employee_documents                 employee_documents[]
  employee_schedules                 employee_schedules[]
  tenants                            tenants                   @relation(fields: [tenant_id], references: [id])
  evaluations                        evaluations[]
  leave_requests                     leave_requests[]
  notification_preferences           notification_preferences?
  orders                             orders[]
  payroll_records                    payroll_records[]
  push_subscriptions                 push_subscriptions[]
  shifts_shifts_closed_byToemployees shifts[]                  @relation("shifts_closed_byToemployees")
  shifts_shifts_opened_byToemployees shifts[]                  @relation("shifts_opened_byToemployees")
  station_alerts                     station_alerts[]
  tips                               tips[]
  training_records                   training_records[]

  @@unique([tenant_id, dni])
  @@index([tenant_id, is_active])
  @@index([tenant_id, location_id])
}

model event_outbox {
  id           String    @id @db.Uuid
  tenant_id    String    @db.Uuid
  event_id     String    @db.Uuid
  payload      Json
  published    Boolean   @default(false)
  published_at DateTime? @db.Timestamptz(6)
  attempts     Int       @default(0)
  last_error   String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  aggregate_id String?   @db.Uuid
  event_type   String?
  max_attempts Int       @default(5)
  next_retry   DateTime? @db.Timestamptz(6)
  tenants      tenants   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, published, created_at])
}

model events {
  id                  String   @id @db.Uuid
  tenant_id           String   @db.Uuid
  occurred_at         DateTime @db.Timestamptz(6)
  received_at         DateTime @default(now()) @db.Timestamptz(6)
  type                String
  entity_type         String
  entity_id           String?  @db.Uuid
  actor_id            String?  @db.Uuid
  actor_role_snapshot String?
  terminal_id         String
  shift_id            String?  @db.Uuid
  payload_version     Int      @default(1)
  payload             Json
  tenants             tenants  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, occurred_at(sort: Desc)])
  @@index([terminal_id, occurred_at(sort: Desc)], map: "idx_events_by_terminal")
  @@index([tenant_id, type, occurred_at(sort: Desc)], map: "idx_events_by_type")
  @@index([tenant_id, entity_id, occurred_at], map: "idx_events_replay")
}

model goods_receipt_items {
  id                String         @id @db.Uuid
  goods_receipt_id  String         @db.Uuid
  inventory_code    String
  quantity_ordered  Decimal        @db.Decimal(10, 3)
  quantity_received Decimal        @db.Decimal(10, 3)
  quantity_rejected Decimal        @default(0) @db.Decimal(10, 3)
  rejection_reason  String?
  unit_cost_cents   Int
  lot_number        String?
  expiry_date       DateTime?      @db.Date
  goods_receipts    goods_receipts @relation(fields: [goods_receipt_id], references: [id])

  @@index([goods_receipt_id])
}

model goods_receipts {
  id                  String                @id @db.Uuid
  tenant_id           String                @db.Uuid
  location_id         String                @db.Uuid
  purchase_order_id   String?               @db.Uuid
  receipt_number      String
  status              String                @default("DRAFT")
  received_by         String                @db.Uuid
  received_at         DateTime              @default(now()) @db.Timestamptz(6)
  notes               String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  goods_receipt_items goods_receipt_items[]
  purchase_orders     purchase_orders?      @relation(fields: [purchase_order_id], references: [id])
  tenants             tenants               @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, location_id, receipt_number])
  @@index([tenant_id, location_id, received_at(sort: Desc)])
  @@index([tenant_id, purchase_order_id])
}

model inventory {
  id                String          @id @db.Uuid
  tenant_id         String          @db.Uuid
  code              String
  name              String
  unit              String
  stock             Decimal         @default(0) @db.Decimal(10, 3)
  min_stock         Decimal?        @db.Decimal(10, 3)
  cost_cents        Int?
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  created_by        String?         @db.Uuid
  expiry_date       DateTime?       @db.Date
  last_count_at     DateTime?       @db.Timestamptz(6)
  location_id       String?         @db.Uuid
  lot_number        String?
  theoretical_stock Decimal         @default(0) @db.Decimal(10, 3)
  updated_by        String?         @db.Uuid
  tenants           tenants         @relation(fields: [tenant_id], references: [id])
  inventory_log     inventory_log[]

  @@unique([tenant_id, code])
  @@index([tenant_id, expiry_date])
  @@index([tenant_id, location_id, code])
}

model inventory_count_items {
  id                     String           @id @db.Uuid
  inventory_count_id     String           @db.Uuid
  inventory_code         String
  expected_qty           Decimal          @db.Decimal(10, 3)
  counted_qty            Decimal          @db.Decimal(10, 3)
  difference_qty         Decimal          @db.Decimal(10, 3)
  unit_cost_cents        Int
  difference_value_cents Int
  notes                  String?
  inventory_counts       inventory_counts @relation(fields: [inventory_count_id], references: [id])

  @@index([inventory_count_id])
}

model inventory_counts {
  id                    String                  @id @db.Uuid
  tenant_id             String                  @db.Uuid
  location_id           String                  @db.Uuid
  count_date            DateTime                @db.Date
  count_type            String                  @default("FULL")
  status                String                  @default("IN_PROGRESS")
  counted_by            String                  @db.Uuid
  approved_by           String?                 @db.Uuid
  approved_at           DateTime?               @db.Timestamptz(6)
  notes                 String?
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  inventory_count_items inventory_count_items[]
  tenants               tenants                 @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, location_id, count_date(sort: Desc)])
}

model inventory_log {
  id            String    @id @db.Uuid
  tenant_id     String    @db.Uuid
  inventory_id  String    @db.Uuid
  movement_type String
  quantity      Decimal   @db.Decimal(10, 3)
  reference_id  String?   @db.Uuid
  reason        String?
  actor_id      String?   @db.Uuid
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  inventory     inventory @relation(fields: [inventory_id], references: [id])
  tenants       tenants   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, inventory_id, created_at(sort: Desc)])
  @@index([inventory_id])
}

model locations {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String           @db.Uuid
  code           String
  name           String
  address        String?
  phone          String?
  timezone       String           @default("America/Lima")
  is_active      Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  delivery_zones delivery_zones[]
  tenants        tenants          @relation(fields: [tenant_id], references: [id])
  orders         orders[]
  tables         tables[]
  zones          zones[]

  @@unique([tenant_id, code])
  @@index([tenant_id, is_active])
}

model invoice_cdr {
  id               String   @id @db.Uuid
  tenant_id        String   @db.Uuid
  invoice_id       String   @db.Uuid
  response_code    String
  response_message String
  hash             String?
  cdr_xml          String?
  received_at      DateTime @default(now()) @db.Timestamptz(6)
  invoices         invoices @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  tenants          tenants  @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, invoice_id])
}

model invoice_queue {
  id              String    @id @db.Uuid
  tenant_id       String    @db.Uuid
  invoice_id      String    @db.Uuid
  action          String
  priority        Int       @default(5)
  attempts        Int       @default(0)
  max_attempts    Int       @default(3)
  last_attempt_at DateTime? @db.Timestamptz(6)
  last_error      String?
  scheduled_at    DateTime  @default(now()) @db.Timestamptz(6)
  processed_at    DateTime? @db.Timestamptz(6)
  status          String    @default("PENDING")
  invoices        invoices  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  tenants         tenants   @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, invoice_id, action])
  @@index([tenant_id, status, scheduled_at])
}

model invoices {
  id                String          @id @db.Uuid
  tenant_id         String          @db.Uuid
  order_id          String          @db.Uuid
  check_id          String
  invoice_type      String
  series            String?
  invoice_number    String?
  customer_doc_type String?
  customer_doc      String?
  total_cents       Int
  payment_summary   Json?
  status            String          @default("ISSUED")
  void_reason       String?
  voided_by         String?         @db.Uuid
  voided_at         DateTime?       @db.Timestamptz(6)
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  credit_notes      credit_notes[]
  invoice_cdr       invoice_cdr[]
  invoice_queue     invoice_queue[]
  orders            orders          @relation(fields: [order_id], references: [id])
  tenants           tenants         @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, order_id, check_id])
  @@unique([tenant_id, series, invoice_number])
  @@index([tenant_id, created_at(sort: Desc)])
}

model payments {
  id             String   @id @db.Uuid
  tenant_id      String   @db.Uuid
  order_id       String   @db.Uuid
  check_id       String
  amount_cents   Int
  payment_method String
  reference      String?
  status         String   @default("COMPLETED")
  processed_at   DateTime @db.Timestamptz(6)
  processed_by   String?  @db.Uuid
  shift_id       String?  @db.Uuid
  terminal_id    String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  orders         orders   @relation(fields: [order_id], references: [id])
  tenants        tenants  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, order_id])
  @@index([tenant_id, check_id])
  @@index([tenant_id, created_at(sort: Desc)])
}

model login_attempts {
  id           String   @id @db.Uuid
  tenant_id    String   @db.Uuid
  employee_id  String?  @db.Uuid
  pin_hash     String
  success      Boolean
  ip_address   String?
  user_agent   String?
  terminal_id  String?
  attempted_at DateTime @default(now()) @db.Timestamptz(6)
  tenants      tenants  @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, employee_id, attempted_at(sort: Desc)])
  @@index([tenant_id, pin_hash, attempted_at(sort: Desc)])
}

model pin_history {
  id          String   @id @db.Uuid
  tenant_id   String   @db.Uuid
  employee_id String   @db.Uuid
  pin_hash    String
  changed_at  DateTime @default(now()) @db.Timestamptz(6)
  changed_by  String?  @db.Uuid
  reason      String?
  tenants     tenants  @relation(fields: [tenant_id], references: [id])

  @@index([employee_id, changed_at(sort: Desc)])
  @@index([tenant_id, changed_at(sort: Desc)])
}

model marketing_campaigns {
  id                  String              @id @db.Uuid
  tenant_id           String              @db.Uuid
  name                String
  channel             String
  segment_id          String?             @db.Uuid
  message_template_id String?             @db.Uuid
  offer               Json?
