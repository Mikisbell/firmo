# PARK POS — Local Development Environment
# This file is gitignored. NEVER commit credentials to git.
# Copy from .env.example and fill in your values.

# Database Configuration (Supabase)
DATABASE_URL=<CONFIGURE_ME>
DIRECT_URL=<CONFIGURE_ME>

# Security Secrets
JWT_SECRET=<CONFIGURE_ME>
REFRESH_TOKEN_SECRET=<CONFIGURE_ME>
PIN_SALT=<CONFIGURE_ME>
PARK_API_SECRET=<CONFIGURE_ME>
NEXT_PUBLIC_API_SECRET=<CONFIGURE_ME>
ADMIN_API_KEY=<CONFIGURE_ME>

# Redis
REDIS_URL=<CONFIGURE_ME>

# VAPID (Web Push)
VAPID_PUBLIC_KEY=<CONFIGURE_ME>
VAPID_PRIVATE_KEY=<CONFIGURE_ME>
VAPID_SUBJECT=<CONFIGURE_ME>

# Tenant / Location
TENANT_ID=<CONFIGURE_ME>
LOCATION_ID=<CONFIGURE_ME>

# NextAuth
NEXTAUTH_SECRET=<CONFIGURE_ME>
NEXTAUTH_URL=<CONFIGURE_ME>
NEXTAUTH_URL_INTERNAL=<CONFIGURE_ME>

# CORS
ALLOWED_ORIGINS=<CONFIGURE_ME>

# SUNAT Configuration
SUNAT_ENCRYPTION_KEY=<CONFIGURE_ME>

