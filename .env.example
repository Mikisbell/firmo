# Database Configuration
# CRITICAL: Never commit actual credentials to Git
DATABASE_URL="postgresql://user:password@host:5432/database"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Redis Configuration
# Development: redis://localhost:6379
# Production (Upstash): rediss://default:password@host.upstash.io:6379
# Production (Redis Cloud): redis://default:password@host.redis.cloud:port
# Production (Railway): redis://default:password@host.railway.app:port
REDIS_URL="redis://localhost:6379"

# Optional: Upstash REST API (alternative to Redis protocol)
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Security - REQUIRED in Production
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-here-minimum-32-characters"
PIN_SALT="your-pin-salt-here-minimum-32-characters"
PARK_API_SECRET="your-api-secret-here"

# Tenant/Location Configuration
# REQUIRED: Configure for your tenant
TENANT_ID="your-tenant-uuid-here"
LOCATION_ID="your-location-uuid-here"

# Web Push Notifications (VAPID)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:your-email@example.com"

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Optional: Admin API Key (for cleanup endpoints)
# ADMIN_API_KEY="your-admin-api-key"
