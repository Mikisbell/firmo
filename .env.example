# ============================================================================
# PARK POS — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults or disable features gracefully.
#
# Generate secrets with: openssl rand -base64 32
# Generate VAPID keys with: npx web-push generate-vapid-keys
# ============================================================================

# --- A. Core Application [REQUIRED] -----------------------------------------

NODE_ENV="development"

# PostgreSQL via Supabase (connection pooler)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20"

# PostgreSQL direct (for Prisma migrations — bypasses PgBouncer)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?connection_limit=1"

# --- B. Security & Authentication [REQUIRED] --------------------------------

# JWT signing secret (min 32 chars) — generate with: openssl rand -base64 32
JWT_SECRET="generate-with-openssl-rand-base64-32"

# PIN hashing salt (min 16 chars) — used for employee PIN authentication
PIN_SALT="generate-with-openssl-rand-base64-32"

# Internal API secret for event ingestion (optional, adds extra auth layer)
# PARK_API_SECRET="generate-with-openssl-rand-base64-32"

# Admin API key for cleanup/maintenance endpoints
# ADMIN_API_KEY="generate-with-openssl-rand-base64-32"

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Vercel Cron secret (auto-set by Vercel, manual for local testing)
# CRON_SECRET="generate-with-openssl-rand-base64-32"

# --- C. Multi-Tenancy [REQUIRED] --------------------------------------------

# Default tenant UUID (from tenants table)
TENANT_ID="00000000-0000-0000-0000-000000000000"

# Default location UUID (from locations table)
LOCATION_ID="00000000-0000-0000-0000-000000000000"

# Client-side tenant ID fallback (only if different from TENANT_ID)
# NEXT_PUBLIC_TENANT_ID="00000000-0000-0000-0000-000000000000"

# --- D. Redis Cache (Optional) ----------------------------------------------
# Falls back to in-memory cache if not set.
# Development: redis://localhost:6379
# Production (Upstash): rediss://default:password@host.upstash.io:6379

REDIS_URL="redis://localhost:6379"

# Optional: Upstash REST API (alternative to Redis protocol)
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token-here"

# --- E. Supabase Storage (Optional) -----------------------------------------
# Required for product image uploads. Without these, images are disabled.

# NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# --- F. Email Notifications via Resend (Optional) ---------------------------
# Without RESEND_API_KEY, email alerts fall back to logging only.
# Register at: https://resend.com/

# RESEND_API_KEY="re_xxxxxxxxxxxx"

# --- G. Web Push Notifications (Optional) ------------------------------------
# Without VAPID keys, push notifications are disabled.
# Generate with: npx web-push generate-vapid-keys

# VAPID_PUBLIC_KEY="BBase64EncodedPublicKey..."
# VAPID_PRIVATE_KEY="Base64EncodedPrivateKey..."
# VAPID_SUBJECT="mailto:admin@yourcompany.com"

# --- G. WhatsApp Messaging via Twilio (Optional) ----------------------------
# Without Twilio credentials, WhatsApp delivery notifications are disabled.

# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your-auth-token"
# TWILIO_WHATSAPP_NUMBER="+15551234567"
# SUPPORT_PHONE="+51999999999"

# --- H. SUNAT Electronic Invoicing (Optional) -------------------------------
# Peru tax authority integration. Default: mock provider (no real invoices).
# Options: mock | nubefact | sunat-direct

# SUNAT_PROVIDER="mock"

# Nubefact provider (recommended for production)
# Register at: https://www.nubefact.com/
# NUBEFACT_TOKEN="your-nubefact-api-token"
# NUBEFACT_URL="https://api.nubefact.com/api/v1/..."
# SUNAT_RUC="20123456789"

# Direct SUNAT (advanced — requires digital certificate)
# SUNAT_USERNAME="MODDATOS"
# SUNAT_PASSWORD="moddatos"
# SUNAT_CERTIFICATE="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SUNAT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# SUNAT credential encryption key (required for per-tenant encrypted credentials)
# 64 hex chars (256 bits). Generate with: openssl rand -hex 32
# SUNAT_ENCRYPTION_KEY=

# --- I. External Delivery Platforms (Optional) ------------------------------
# Webhook integrations with food delivery platforms.

# PEDIDOSYA_API_KEY="your-pedidosya-key"
# PEDIDOSYA_STORE_ID="your-store-id"
# PEDIDOSYA_WEBHOOK_SECRET="your-webhook-secret"
# LLAMAFOOD_API_KEY="your-llamafood-key"
# RAPPI_API_KEY="your-rappi-key"

# --- J. Observability (Optional) --------------------------------------------

# Logging level: debug | info | warn | error (default: info)
# LOG_LEVEL="info"

# Per-module log levels (override global)
# LOG_LEVEL_AUTH="debug"
# LOG_LEVEL_SYNC="info"
# LOG_LEVEL_EVENTS="info"

# Logtail / BetterStack log aggregation
# LOGTAIL_SOURCE_TOKEN="your-logtail-source-token"

# Sentry error tracking
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# SENTRY_TRACES_SAMPLE_RATE="0.1"

# OpenTelemetry distributed tracing
# Traces are auto-injected into Pino logs (trace_id, span_id)
# Compatible with: Grafana Tempo, Jaeger, Honeycomb, Axiom, etc.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otel-collector.example.com:4318"
# OTEL_SERVICE_NAME="park-pos"

# --- K. Analytics (Optional) ------------------------------------------------
# Auto-configured when deployed on Vercel.

# VERCEL_ANALYTICS_ENDPOINT="https://..."
# VERCEL_ANALYTICS_TOKEN="your-token"

# --- L. App URLs (Optional) -------------------------------------------------

# Public-facing app URL (used for WhatsApp links, sync callbacks)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Client-side API secret for offline sync
# NEXT_PUBLIC_API_SECRET="your-api-secret"

# NextAuth (if using NextAuth.js)
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"
