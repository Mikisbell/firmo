/**
 * Event Ordering and Causality Property Tests
 * 
 * Tests event ordering and causal dependencies:
 * - Commutative operations produce same result in any order
 * - Out-of-order events are reordered by occurred_at
 * - Causal dependencies maintain correct ordering
 * 
 * **Validates: Requirements 2.1, 2.6, 5.4**
 */

import { describe, it, expect } from 'vitest';
import * as fc from 'fast-check';
import {
  orderCreatedEventArb,
  checkMarkedPaidEventArb,
  generateRealisticEventSequence,
} from '@/src/test-utils';
import {
  testCommutativity,
  testInvariant,
} from '@/src/test-utils';

/**
 * Reorders events by occurred_at timestamp
 */
function reorderEventsByTimestamp(events: any[]): any[] {
  return [...events].sort((a, b) => {
    const timeA = new Date(a.occurred_at).getTime();
    const timeB = new Date(b.occurred_at).getTime();
    return timeA - timeB;
  });
}

/**
 * Applies events in order to build state
 */
function applyEventsInOrder(events: any[]): any {
  let state = { items: [], checks: [] };

  for (const event of events) {
    if (event.payload.type === 'ORDER_ITEM_ADDED') {
      state.items.push(event.payload.line) as any;
    } else if (event.payload.type === 'CHECK_MARKED_PAID') {
      state.checks.push(event.payload.check_id) as any;
    }
  }

  return state;
}

/**
 * Checks if events have causal dependency
 */
function hasCausalDependency(event1: any, event2: any): boolean {
  // Event2 depends on Event1 if:
  // - They're on same aggregate
  // - Event2's causation_id references Event1's event_id
  return (
    event1.aggregate_id === event2.aggregate_id &&
    event2.causation_id === event1.event_id
  );
}

/**
 * Validates causal ordering
 */
function validateCausalOrdering(events: any[]): boolean {
  for (let i = 0; i < events.length; i++) {
    for (let j = i + 1; j < events.length; j++) {
      const event1 = events[i];
      const event2 = events[j];

      // If event2 depends on event1, event1 must come first
      if (hasCausalDependency(event1, event2)) {
        const time1 = new Date(event1.occurred_at).getTime();
        const time2 = new Date(event2.occurred_at).getTime();
        if (time1 > time2) {
          return false; // Causal ordering violated
        }
      }
    }
  }
  return true;
}

describe('Event Ordering and Causality - Property Tests', () => {
  describe('Property 5: Commutative Operations Order Independence', () => {
    it('adding items in any order produces same result', () => {
      fc.assert(
        fc.property(
          fc.array(orderCreatedEventArb, { minLength: 2, maxLength: 5 }),
          (events) => {
            // Apply events in original order
            const state1 = applyEventsInOrder(events);

            // Apply events in reversed order
            const state2 = applyEventsInOrder([...events].reverse());

            // For commutative operations (adding items), order shouldn't matter
            // Both should have same number of items
            expect(state1.items.length).toBe(state2.items.length);
          }
        ),
        { numRuns: 100 }
      );
    });

    it('commutative events produce deterministic result', () => {
      fc.assert(
        fc.property(
          fc.array(orderCreatedEventArb, { minLength: 1, maxLength: 5 }),
          (events) => {
            const state1 = applyEventsInOrder(events);
            const state2 = applyEventsInOrder(events);

            expect(state1.items.length).toBe(state2.items.length);
            expect(state1.checks.length).toBe(state2.checks.length);
          }
        ),
        { numRuns: 100 }
      );
    });
  });

  describe('Property 9: Causal Event Ordering', () => {
    it('events with causal dependencies maintain order', () => {
      fc.assert(
        fc.property(
          fc.array(orderCreatedEventArb, { minLength: 1, maxLength: 10 }),
          (events) => {
            // Add causal dependencies
            const eventsWithCausality = events.map((event, index) => ({
              ...event,
              causation_id: index > 0 ? events[index - 1].event_id : null,
            }));

            // Validate causal ordering
            const isValid = validateCausalOrdering(eventsWithCausality);
            expect(isValid).toBe(true);
          }
        ),
        { numRuns: 100 }
      );
    });

    it('reordering by timestamp preserves causal order', () => {
      fc.assert(
        fc.property(
          fc.array(orderCreatedEventArb, { minLength: 2, maxLength: 10 }),
          (events) => {
            // Create events with proper timestamps for causal order
            const eventsWithTimestamps = events.map((event, index) => ({
              ...event,
              occurred_at: new Date(Date.now() + index * 1000).toISOString(),
              causation_id: index > 0 ? events[index - 1].event_id : null,
            }));

            // Shuffle events
            const shuffled = [...eventsWithTimestamps].sort(() => Math.random() - 0.5);

            // Reorder by timestamp
            const reordered = reorderEventsByTimestamp(shuffled);

            // Causal order should be preserved
            const isValid = validateCausalOrdering(reordered);
            expect(isValid).toBe(true);
          }
        ),
        { numRuns: 100 }
      );
    });

    it('events without causal dependencies can be reordered', () => {
      fc.assert(
        fc.property(
          fc.array(orderCreatedEventArb, { minLength: 2, maxLength: 5 }),
          (events) => {
            // Events without causal dependencies
            const independentEvents = events.map(event => ({
              ...event,
              causation_id: null,
            }));

            // Reorder by timestamp
            const reordered = reorderEventsByTimestamp(independentEvents);

            // Should still be valid (no causal constraints)
            const isValid = validateCausalOrdering(reordered);
            expect(isValid).toBe(true);
          }
        ),
        { numRuns: 100 }
      );
    });
  });

  describe('Event Timestamp Ordering', () => {
    it('reordering by timestamp is deterministic', () => {
      fc.assert(
        fc.property(
          fc.array(orderCreatedEventArb, { minLength: 1, maxLength: 10 }),
          (events) => {
            const reordered1 = reorderEventsByTimestamp(events);
            const reordered2 = reorderEventsByTimestamp(events);

            // Should produce same order
            expect(reordered1.length).toBe(reordered2.length);
            for (let i = 0; i < reordered1.length; i++) {
              expect(reordered1[i].event_id).toBe(reordered2[i].event_id);
            }
          }
        ),
        { numRuns: 100 }
      );
    });

    it('reordered events maintain temporal order', () => {
      testInvariant(
        fc.array(orderCreatedEventArb, { minLength: 2, maxLength: 10 }),
        (events) => {
          const reordered = reorderEventsByTimestamp(events);
          for (let i = 1; i < reordered.length; i++) {
            const time1 = new Date(reordered[i - 1].occurred_at).getTime();
            const time2 = new Date(reordered[i].occurred_at).getTime();
            if (time1 > time2) {
              return false;
            }
          }
          return true;
        },
        'Reordered events must maintain temporal order'
      );
    });
  });

  describe('Edge Cases', () => {
    it('handles single event', () => {
      fc.assert(
        fc.property(orderCreatedEventArb, (event) => {
          const reordered = reorderEventsByTimestamp([event]);
          expect(reordered.length).toBe(1);
          expect(reordered[0].event_id).toBe(event.event_id);
        }),
        { numRuns: 100 }
      );
    });

    it('handles events with same timestamp', () => {
      fc.assert(
        fc.property(
          fc.array(orderCreatedEventArb, { minLength: 2, maxLength: 5 }),
          (events) => {
            // Set all events to same timestamp
            const sameTimeEvents = events.map(event => ({
              ...event,
              occurred_at: new Date('2026-01-15T12:00:00Z').toISOString(),
            }));

            const reordered = reorderEventsByTimestamp(sameTimeEvents);
            expect(reordered.length).toBe(sameTimeEvents.length);
          }
        ),
        { numRuns: 100 }
      );
    });

    it('handles events in reverse chronological order', () => {
      fc.assert(
        fc.property(
          fc.array(orderCreatedEventArb, { minLength: 2, maxLength: 10 }),
          (events) => {
            // Create events in reverse chronological order
            const reverseEvents = events.map((event, index) => ({
              ...event,
              occurred_at: new Date(Date.now() - index * 1000).toISOString(),
            }));

            const reordered = reorderEventsByTimestamp(reverseEvents);

            // Should be sorted in ascending order
            for (let i = 1; i < reordered.length; i++) {
              const time1 = new Date(reordered[i - 1].occurred_at).getTime();
              const time2 = new Date(reordered[i].occurred_at).getTime();
              expect(time1).toBeLessThanOrEqual(time2);
            }
          }
        ),
        { numRuns: 100 }
      );
    });
  });

  describe('Invariants', () => {
    it('reordering preserves all events', () => {
      testInvariant(
        fc.array(orderCreatedEventArb, { minLength: 1, maxLength: 10 }),
        (events) => {
          const reordered = reorderEventsByTimestamp(events);
          return reordered.length === events.length;
        },
        'Reordering must preserve all events'
      );
    });

    it('reordering preserves event IDs', () => {
      testInvariant(
        fc.array(orderCreatedEventArb, { minLength: 1, maxLength: 10 }),
        (events) => {
          const reordered = reorderEventsByTimestamp(events);
          const originalIds = new Set(events.map(e => e.event_id));
          const reorderedIds = new Set(reordered.map(e => e.event_id));
          return originalIds.size === reorderedIds.size;
        },
        'Reordering must preserve event IDs'
      );
    });
  });
});

